<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration
    ================================
    - All cleartext traffic is blocked (enforces HTTPS/TLS for all network calls).
    - Certificate pinning for the NYC ElectrumX server (electrum.paywith.nyc:50002).

    !! CERT RENEWAL CHECKLIST !!
    The Let's Encrypt leaf cert expires every 90 days. When it is renewed on the VPS:

    1. Regenerate the leaf cert pin:
           openssl s_client -connect electrum.paywith.nyc:50002 2>/dev/null \
               | openssl x509 -pubkey -noout \
               | openssl pkey -pubin -outform DER \
               | openssl dgst -sha256 -binary \
               | base64
       Replace the Primary pin below with the new hash.

    2. Verify the intermediate CA has not changed (R12 as of 2026-07-29):
           openssl s_client -connect electrum.paywith.nyc:50002 -showcerts 2>/dev/null \
               | awk '/-----BEGIN CERTIFICATE-----/{i++;if(i==2){p=1}} p{print} /-----END CERTIFICATE-----/{if(p){exit}}' \
               | openssl x509 -pubkey -noout \
               | openssl pkey -pubin -outform DER \
               | openssl dgst -sha256 -binary \
               | base64
       Update the Backup pin if the intermediate has rotated.

    3. REBUILD AND REDEPLOY THE APP — the new pins take effect only after users install
       the updated APK. Users on the old build will see "Pin verification failed" and the
       NYC wallet will silently fail to sync until they update.
       Release the new APK before or immediately after renewing the server cert.

    TIP: To decouple cert rotation from app releases, consider pinning only the
    intermediate CA (keep the Backup pin, drop the Primary leaf pin). The intermediate
    changes far less frequently than the leaf cert.

    VPS deploy hook: /etc/letsencrypt/renewal-hooks/deploy/electrumx.sh
    (restarts ElectrumX and fixes ACL permissions on new archive files)
-->
<network-security-config>

    <!-- Block all cleartext (HTTP) traffic app-wide -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only the system CA store (no user-installed CAs) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        NYC ElectrumX server pin.
        Pin set should contain the SPKI hash of the leaf cert AND a backup CA/intermediate pin
        so the app continues to work if the leaf cert is rotated before the app is updated.
        Update these pins whenever the server certificate is renewed.
    -->
    <domain-config>
        <domain includeSubdomains="false">electrum.paywith.nyc</domain>
        <pin-set expiration="2027-01-01">
            <!-- Primary: SPKI hash of the leaf cert (Let's Encrypt RSA, expires 2026-07-29) -->
            <pin digest="SHA-256">f6nvkA5/JyhWZU55IeHDfyt8+Zg12qR/HFGQ86O1BJw=</pin>
            <!-- Backup: SPKI hash of the Let's Encrypt R12 intermediate CA -->
            <pin digest="SHA-256">kZwN96eHtZftBWrOZUsd6cA4es80n3NzSk/XtYz2EqQ=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

</network-security-config>

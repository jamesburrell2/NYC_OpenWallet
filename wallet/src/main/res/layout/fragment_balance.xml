<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Balance header: included directly so ButterKnife can find its views via
         the fragment root's findViewByIdTraversal. Previously this was a ListView
         addHeaderView(), which is NOT traversed by View.findViewById(). -->
    <include layout="@layout/fragment_balance_header" />

    <com.openwallet.wallet.ui.widget.SwipeRefreshLayout
        android:id="@+id/swipeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/transaction_rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />

    </com.openwallet.wallet.ui.widget.SwipeRefreshLayout>

</LinearLayout>
